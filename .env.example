# ============================================
# FINANCIAL PLANNING PLATFORM - CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# MONGODB CONFIGURATION
# ============================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=fdfed

# ============================================
# JWT & AUTHENTICATION
# ============================================
# Generate a strong JWT secret for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CARD_ENC_KEY=your-card-encryption-key-change-in-production

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:5000

# ============================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================
# For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_PASSWORD=your-16-character-app-password

# ============================================
# FINANCIAL DATA APIs
# ============================================
# Finnhub API Key:
# 1. Get from: https://finnhub.io/dashboard/api-token
# 2. Sign up for a FREE account (includes 60 API calls/minute)
# 3. Copy your API key here
FINNHUB_API_KEY=your-finnhub-api-key

# Currency Conversion Rate (INR per USD)
# Update periodically or use a currency API
USD_TO_INR=83.5

# ============================================
# AI & PYTHON SERVICES
# ============================================
# URL for Python AI service (for financial advice)
# This is optional - if not running, the app will work with fallback responses
PYTHON_AI_URL=http://127.0.0.1:5002/api/financial-advice

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
MORGAN_LOG_FORMAT=combined

# ============================================
# RATE LIMITING
# ============================================
# Rate limit window in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=true

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
# Maximum file size in bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ============================================
# PRODUCTION TIPS
# ============================================
# 1. Change JWT_SECRET to a strong random value
# 2. Use MongoDB Atlas for cloud database
# 3. Enable HTTPS/SSL certificates
# 4. Use environment-specific .env files
# 5. Never commit .env files to version control
# 6. Use secrets management services in production
